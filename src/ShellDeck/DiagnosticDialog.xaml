<Window x:Class="ShellDeck.DiagnosticDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="680" Height="520" MinWidth="360" MinHeight="260" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource ChromeBrush}" Foreground="{StaticResource ForegroundBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13">
    <DockPanel Margin="20,18,20,18">
        <TextBlock x:Name="HeadingText" DockPanel.Dock="Top" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,10" />
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Style="{StaticResource DialogButtonStyle}" Content="Copier" Click="OnCopyClicked" Margin="0,0,8,0" />
            <Button Style="{StaticResource PrimaryButtonStyle}" Content="Fermer" IsDefault="True" IsCancel="True" />
        </StackPanel>
        <TextBox x:Name="ReportText" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                 Background="{StaticResource TerminalBackgroundBrush}" Foreground="{StaticResource ForegroundBrush}"
                 BorderBrush="{StaticResource LineBrush}" Padding="10,8"
                 FontFamily="{StaticResource MonoFont}" FontSize="12" />
    </DockPanel>
</Window>
