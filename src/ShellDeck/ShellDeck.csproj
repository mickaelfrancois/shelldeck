<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>ShellDeck</RootNamespace>
    <ApplicationIcon>Assets\shelldeck.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Hosts xterm.js, the terminal emulator (VT parsing + rendering). -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
  </ItemGroup>

  <ItemGroup>
    <None Update="wwwroot\**" CopyToOutputDirectory="PreserveNewest" />
    <Resource Include="Assets\shelldeck.ico" />
  </ItemGroup>

</Project>
