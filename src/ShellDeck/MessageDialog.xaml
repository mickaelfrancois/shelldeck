<Window x:Class="ShellDeck.MessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="420" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource ChromeBrush}" Foreground="{StaticResource ForegroundBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13">
    <StackPanel Margin="20,18,20,18">
        <DockPanel>
            <Border x:Name="Badge" DockPanel.Dock="Left" Width="30" Height="30" CornerRadius="15" Margin="0,0,14,0" VerticalAlignment="Top">
                <TextBlock x:Name="BadgeGlyph" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="HeadingText" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock x:Name="DetailText" Foreground="{StaticResource MutedForegroundBrush}" TextWrapping="Wrap" Margin="0,6,0,0" />
            </StackPanel>
        </DockPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button x:Name="CancelButton" Style="{StaticResource DialogButtonStyle}" Content="Annuler" IsCancel="True" Margin="0,0,8,0" />
            <Button x:Name="ConfirmButton" Style="{StaticResource PrimaryButtonStyle}" IsDefault="True" Click="OnConfirmClicked" />
        </StackPanel>
    </StackPanel>
</Window>
