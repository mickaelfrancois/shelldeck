<Window x:Class="ShellDeck.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shelldeck="clr-namespace:ShellDeck"
        xmlns:terminal="clr-namespace:ShellDeck.Terminal"
        xmlns:viewModels="clr-namespace:ShellDeck.ViewModels"
        Title="{Binding SelectedTab.Title, StringFormat={}{0} — ShellDeck, FallbackValue=ShellDeck, TargetNullValue=ShellDeck}"
        Icon="/Assets/shelldeck.ico"
        Width="1200" Height="750"
        Background="{StaticResource ChromeBrush}" Foreground="{StaticResource ForegroundBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13">
    <Window.Resources>
        <!-- Shared by every terminal of the launcher: its DataContext is the ShellProfile it was opened on. -->
        <ContextMenu x:Key="ProfileContextMenu">
            <MenuItem Header="Ouvrir au démarrage" Click="OnSetDefaultProfileClicked" />
            <MenuItem Header="Monter" Click="OnMoveProfileUpClicked" />
            <MenuItem Header="Descendre" Click="OnMoveProfileDownClicked" />
            <MenuItem Header="Modifier…" Click="OnEditProfileClicked"
                      Visibility="{Binding HasStartingDirectory, Converter={x:Static shelldeck:Converters.TrueToVisible}}" />
            <MenuItem Header="Modifier ~/.ssh/config" Click="OnEditSshConfigClicked"
                      Visibility="{Binding HasStartingDirectory, Converter={x:Static shelldeck:Converters.FalseToVisible}}" />
            <MenuItem Header="Masquer" Click="OnHideProfileClicked" />
            <MenuItem Header="Supprimer…" Click="OnDeleteProfileClicked"
                      Visibility="{Binding IsCustom, Converter={x:Static shelldeck:Converters.TrueToVisible}}" />
        </ContextMenu>

        <ContextMenu x:Key="HiddenProfileContextMenu">
            <MenuItem Header="Afficher" Click="OnShowProfileClicked" />
            <MenuItem Header="Supprimer…" Click="OnDeleteProfileClicked"
                      Visibility="{Binding IsCustom, Converter={x:Static shelldeck:Converters.TrueToVisible}}" />
        </ContextMenu>

        <!-- A color of the tab menu; the ring marks the tab's current color. -->
        <Style x:Key="ColorSwatchStyle" TargetType="Button">
            <Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border CornerRadius="6" BorderThickness="2" BorderBrush="{StaticResource ForegroundBrush}">
                                <Border.Visibility>
                                    <MultiBinding Converter="{x:Static shelldeck:Converters.EqualToVisible}">
                                        <Binding Path="Hex" />
                                        <Binding Path="DataContext.Color.Hex" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                    </MultiBinding>
                                </Border.Visibility>
                            </Border>
                            <Border x:Name="Swatch" Margin="4" CornerRadius="3" Background="{Binding Hex}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Swatch" Property="Margin" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Shared by every tab of the list: its DataContext is the TerminalTab it was opened on. -->
        <ContextMenu x:Key="TabContextMenu">
            <MenuItem Header="Modifier la couleur de l'onglet…" Click="OnEditTabColorClicked" />
        </ContextMenu>

        <!-- Star shown next to the profile opened at startup. -->
        <Style x:Key="DefaultProfileMarkStyle" TargetType="TextBlock">
            <Setter Property="Text" Value="★" />
            <Setter Property="Foreground" Value="{StaticResource AttentionBrush}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="ToolTip" Value="Ouvert au démarrage" />
            <Setter Property="Visibility">
                <Setter.Value>
                    <MultiBinding Converter="{x:Static shelldeck:Converters.EqualToVisible}">
                        <Binding Path="Id" />
                        <Binding Path="DataContext.DefaultProfileId" RelativeSource="{RelativeSource AncestorType=Window}" />
                    </MultiBinding>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Divider between two panes: drawn in the 4 px gap left between their terminals. -->
        <Style x:Key="PaneSplitterStyle" TargetType="Thumb">
            <Setter Property="Width" Value="4" />
            <Setter Property="Cursor" Value="SizeWE" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="Transparent">
                            <Border x:Name="Line" Background="{StaticResource LineBrush}" Width="1" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding Direction}" Value="{x:Static viewModels:SplitDirection.Down}">
                                <Setter TargetName="Line" Property="Width" Value="NaN" />
                                <Setter TargetName="Line" Property="Height" Value="1" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Line" Property="Background" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="Line" Property="Background" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Direction}" Value="{x:Static viewModels:SplitDirection.Down}">
                    <Setter Property="Width" Value="NaN" />
                    <Setter Property="Height" Value="4" />
                    <Setter Property="Cursor" Value="SizeNS" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Side panel: open tabs, then the launcher (shells + SSH connections). -->
        <Border Width="270" BorderBrush="{StaticResource LineBrush}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="DockPanel.Dock" Value="Left" />
                    <Setter Property="BorderThickness" Value="0,0,1,0" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding PanelSide}" Value="{x:Static shelldeck:PanelSide.Right}">
                            <Setter Property="DockPanel.Dock" Value="Right" />
                            <Setter Property="BorderThickness" Value="1,0,0,0" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <DockPanel>
                <!-- Footer: application-level actions (keyboard reference, settings). -->
                <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="8,6">
                    <StackPanel Orientation="Horizontal">
                        <!-- Not clickable while open: the click that closes the popup would otherwise reopen it. -->
                        <ToggleButton x:Name="ShortcutHelpButton" Style="{StaticResource IconButtonStyle}" Width="26" Height="26"
                                      Content="&#xE765;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15"
                                      ToolTip="Raccourcis clavier" AutomationProperties.Name="Raccourcis clavier"
                                      IsChecked="{Binding IsOpen, ElementName=ShortcutHelpPopup}"
                                      IsHitTestVisible="{Binding IsOpen, ElementName=ShortcutHelpPopup, Converter={x:Static shelldeck:Converters.Not}}" />
                        <Button Style="{StaticResource IconButtonStyle}" Width="26" Height="26" Margin="4,0,0,0"
                                Content="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15"
                                ToolTip="Paramètres (settings.json)" AutomationProperties.Name="Paramètres"
                                Click="OnSettingsClicked" />
                    </StackPanel>
                </Border>

                <Popup x:Name="ShortcutHelpPopup" PlacementTarget="{Binding ElementName=ShortcutHelpButton}" Placement="Top"
                       VerticalOffset="-6" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                    <Border Width="440" Margin="0,0,16,16" Padding="16,12,16,14"
                            Background="{StaticResource ChromeRaisedBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.5" />
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="Raccourcis clavier" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,4" />
                            <ItemsControl ItemsSource="{x:Static shelldeck:ShortcutHelp.Sections}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,10,0,0">
                                            <TextBlock Text="{Binding Title}" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,4" />
                                            <ItemsControl ItemsSource="{Binding Entries}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,2">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="180" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Keys}" FontFamily="{StaticResource MonoFont}" FontSize="12"
                                                                       Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap" Margin="0,0,12,0" />
                                                            <TextBlock Grid.Column="1" Text="{Binding Description}" FontSize="12" TextWrapping="Wrap" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Popup>

                <!-- As Windows Terminal's tab color flyout: a grid of colors, then reset and custom. DataContext: the tab. -->
                <Popup x:Name="TabColorFlyout" Placement="MousePoint" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                    <Border Margin="0,0,16,16" Padding="10"
                            Background="{StaticResource ChromeRaisedBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.5" />
                        </Border.Effect>
                        <StackPanel Width="184">
                            <ItemsControl ItemsSource="{x:Static viewModels:TabColor.Palette}" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="4" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type viewModels:TabColor}">
                                        <Button Style="{StaticResource ColorSwatchStyle}" Click="OnTabColorClicked"
                                                ToolTip="{Binding Name}" AutomationProperties.Name="{Binding Name}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <UniformGrid Columns="2" Margin="0,10,0,0">
                                <Button Style="{StaticResource DialogButtonStyle}" MinWidth="0" Padding="8,6" Margin="0,0,4,0"
                                        Content="Réinitialiser" Click="OnResetTabColorClicked" />
                                <Button Style="{StaticResource DialogButtonStyle}" MinWidth="0" Padding="8,6" Margin="4,0,0,0"
                                        Content="Personnalisé" Click="OnCustomTabColorClicked" />
                            </UniformGrid>
                        </StackPanel>
                    </Border>
                </Popup>

                <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,10">
                    <StackPanel>
                        <DockPanel Margin="12,0,8,8">
                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButtonStyle}" Content="+" FontSize="15"
                                    ToolTip="Ajouter un terminal…" AutomationProperties.Name="Ajouter un terminal" Click="OnAddProfileClicked" />
                            <TextBlock Text="NOUVEAU TERMINAL" Style="{StaticResource SectionHeaderStyle}" />
                        </DockPanel>
                        <TextBox x:Name="FilterBox" Style="{StaticResource FilterBoxStyle}" Margin="10,0,10,8"
                                 Tag="Filtrer (nom, hôte, IP)…"
                                 Visibility="{Binding IsFilterVisible, Converter={x:Static shelldeck:Converters.TrueToVisible}}"
                                 Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                                 PreviewKeyDown="OnFilterKeyDown" />

                        <ItemsControl ItemsSource="{Binding Shells}" Margin="0,0,0,6">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource RowButtonStyle}" Margin="6,0" Click="OnProfileClicked"
                                            ContextMenu="{StaticResource ProfileContextMenu}">
                                        <DockPanel>
                                            <ContentControl DockPanel.Dock="Left" Content="{Binding}" ContentTemplate="{StaticResource ShellTileTemplate}"
                                                            Width="20" Height="20" FontSize="9" Margin="0,0,8,0" Focusable="False" />
                                            <TextBlock DockPanel.Dock="Left" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Style="{StaticResource DefaultProfileMarkStyle}" HorizontalAlignment="Left" />
                                        </DockPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <ToggleButton IsChecked="{Binding IsSshExpanded}" Style="{StaticResource RowButtonStyle}" Margin="6,0"
                                      Foreground="{StaticResource MutedForegroundBrush}" FontSize="11">
                            <ToggleButton.Visibility>
                                <Binding Path="SshConnectionCount" Converter="{x:Static shelldeck:Converters.PositiveToVisible}" />
                            </ToggleButton.Visibility>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="~/.ssh/config" FontFamily="{StaticResource MonoFont}" FontSize="10" VerticalAlignment="Center" />
                                <TextBlock Style="{StaticResource ChevronStyle}" Tag="{Binding IsSshListVisible}" />
                                <TextBlock Text="{Binding SshHeader}" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </DockPanel>
                        </ToggleButton>

                        <ScrollViewer MaxHeight="230" VerticalScrollBarVisibility="Auto"
                                      Visibility="{Binding IsSshListVisible, Converter={x:Static shelldeck:Converters.TrueToVisible}}">
                            <StackPanel>
                                <ItemsControl ItemsSource="{Binding SshConnections}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource RowButtonStyle}" Margin="6,0" Click="OnProfileClicked"
                                                    ContextMenu="{StaticResource ProfileContextMenu}">
                                                <DockPanel>
                                                    <ContentControl DockPanel.Dock="Left" Content="{Binding}" ContentTemplate="{StaticResource ShellTileTemplate}"
                                                                    Width="20" Height="20" FontSize="8" Margin="0,0,8,0" Focusable="False" />
                                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource DefaultProfileMarkStyle}" />
                                                    <Border Width="8" DockPanel.Dock="Left" />
                                                    <TextBlock Text="{Binding Location}" FontFamily="{StaticResource MonoFont}" FontSize="11"
                                                               Foreground="{StaticResource MutedForegroundBrush}" VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis" />
                                                </DockPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="Aucune connexion ne correspond." Foreground="{StaticResource MutedForegroundBrush}" FontSize="12" Margin="12,2"
                                           Visibility="{Binding HasNoSshMatch, Converter={x:Static shelldeck:Converters.TrueToVisible}}" />
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Hidden terminals: out of the way, but still one click from opening or showing again. -->
                        <ToggleButton IsChecked="{Binding IsHiddenExpanded}" Style="{StaticResource RowButtonStyle}" Margin="6,0"
                                      Foreground="{StaticResource MutedForegroundBrush}" FontSize="11"
                                      Visibility="{Binding IsHiddenSectionVisible, Converter={x:Static shelldeck:Converters.TrueToVisible}}">
                            <DockPanel>
                                <TextBlock Style="{StaticResource ChevronStyle}" Tag="{Binding IsHiddenListVisible}" />
                                <TextBlock Text="{Binding HiddenHeader}" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </DockPanel>
                        </ToggleButton>

                        <ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto"
                                      Visibility="{Binding IsHiddenListVisible, Converter={x:Static shelldeck:Converters.TrueToVisible}}">
                            <ItemsControl ItemsSource="{Binding HiddenProfiles}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource RowButtonStyle}" Margin="6,0" Click="OnProfileClicked"
                                                ContextMenu="{StaticResource HiddenProfileContextMenu}" Opacity="0.6"
                                                ToolTip="Clic droit pour l'afficher à nouveau">
                                            <DockPanel>
                                                <ContentControl DockPanel.Dock="Left" Content="{Binding}" ContentTemplate="{StaticResource ShellTileTemplate}"
                                                                Width="20" Height="20" FontSize="8" Margin="0,0,8,0" Focusable="False" />
                                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            </DockPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <DockPanel DockPanel.Dock="Top" Margin="12,12,8,4">
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButtonStyle}" Content="+" FontSize="15"
                            ToolTip="Nouvel onglet (Ctrl+Maj+T)" Click="OnNewTabClicked" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButtonStyle}" Content="⇆" FontSize="13"
                            ToolTip="Changer le panneau de côté" Click="OnTogglePanelSideClicked" />
                    <TextBlock Text="ONGLETS" Style="{StaticResource SectionHeaderStyle}" />
                </DockPanel>

                <!-- Tabs are reordered by dragging them: they move live under the cursor. -->
                <ListBox x:Name="TabList" ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab}"
                         Background="Transparent" BorderThickness="0" Padding="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         AllowDrop="True" DragOver="OnTabListDragOver" Drop="OnTabListDrop">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="OnTabMouseDown" />
                            <EventSetter Event="PreviewMouseMove" Handler="OnTabMouseMove" />
                            <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
                            <Setter Property="ContextMenu" Value="{StaticResource TabContextMenu}" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Grid Margin="0,1">
                                            <Rectangle x:Name="AttentionBar" Width="3" Margin="0,8" RadiusX="1.5" RadiusY="1.5"
                                                       HorizontalAlignment="Left" Fill="{StaticResource AttentionBrush}" Visibility="Collapsed" />
                                            <!-- The 1px border is always there, transparent, so outlining a dragged tab does not shift its content. -->
                                            <Border x:Name="Chrome" Margin="6,0" Padding="7,6" CornerRadius="6" Background="Transparent"
                                                    BorderThickness="1" BorderBrush="Transparent">
                                                <ContentPresenter />
                                            </Border>
                                            <!-- The color the user gave the tab: the card's left edge, curving into its rounded corners. -->
                                            <Border x:Name="ColorStripe" Margin="6,0" CornerRadius="6" BorderThickness="3,0,0,0"
                                                    BorderBrush="{Binding Color.Hex}" IsHitTestVisible="False" />
                                            <!-- Marks the current tab: the card's edge facing the terminal, curving into its corners,
                                                 with an arrow in the gutter pointing to the terminal. -->
                                            <Grid x:Name="CurrentMark" RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False" Visibility="Collapsed">
                                                <Border Margin="6,0" CornerRadius="6" BorderThickness="0,0,3,0" BorderBrush="{StaticResource CurrentTabBrush}" />
                                                <Path Data="M0,0 L5,5 L0,10 Z" Margin="0,0,1,0" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                      Fill="{StaticResource CurrentTabBrush}" />
                                            </Grid>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource ChromeHoverBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource ChromeSelectedBrush}" />
                                                <Setter TargetName="CurrentMark" Property="Visibility" Value="Visible" />
                                            </Trigger>
                                            <!-- Panel on the right: the terminal is on the left, the mark follows it and the color takes the other edge. -->
                                            <DataTrigger Binding="{Binding DataContext.PanelSide, RelativeSource={RelativeSource AncestorType=Window}}"
                                                         Value="{x:Static shelldeck:PanelSide.Right}">
                                                <Setter TargetName="ColorStripe" Property="BorderThickness" Value="0,0,3,0" />
                                                <Setter TargetName="CurrentMark" Property="RenderTransform">
                                                    <Setter.Value>
                                                        <ScaleTransform ScaleX="-1" />
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="{x:Static viewModels:TerminalStatus.Attention}">
                                                <Setter TargetName="AttentionBar" Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsDragged}" Value="True">
                                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource ChromeSelectedBrush}" />
                                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                            </DataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type viewModels:TerminalTab}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="22" />
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0" Width="28" Height="28">
                                    <ContentControl Content="{Binding Profile}" ContentTemplate="{StaticResource ShellTileTemplate}" FontSize="11" Focusable="False" />
                                    <Border x:Name="ClaudeBadge" Width="15" Height="15" CornerRadius="7.5" Margin="0,0,-5,-5"
                                            HorizontalAlignment="Right" VerticalAlignment="Bottom" ToolTip="Claude Code"
                                            Background="{StaticResource ClaudeBrush}" BorderBrush="{StaticResource ChromeBrush}" BorderThickness="2"
                                            Visibility="Collapsed">
                                        <TextBlock Text="✳" FontSize="7" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </Grid>

                                <StackPanel Grid.Column="1" Margin="10,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="TitleText" Text="{Binding Title}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" />
                                    <TextBlock x:Name="SubtitleText" Text="{Binding Subtitle}" FontSize="11" Margin="0,1,0,0"
                                               Foreground="{StaticResource MutedForegroundBrush}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <Grid Grid.Column="2" VerticalAlignment="Center">
                                    <Ellipse x:Name="AttentionBadge" Width="8" Height="8" Fill="{StaticResource AttentionBrush}" Visibility="Collapsed" />
                                    <TextBlock x:Name="Spinner" Text="◐" Foreground="{StaticResource AccentBrush}" FontSize="13"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5" Visibility="Collapsed">
                                        <TextBlock.RenderTransform>
                                            <RotateTransform />
                                        </TextBlock.RenderTransform>
                                    </TextBlock>
                                    <Button x:Name="CloseButton" Style="{StaticResource IconButtonStyle}" Content="✕" FontSize="10"
                                            ToolTip="Fermer l'onglet" Click="OnCloseTabClicked" Visibility="Collapsed" />
                                </Grid>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsClaudeSession}" Value="True">
                                    <Setter TargetName="ClaudeBadge" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="{x:Static viewModels:TerminalStatus.Attention}">
                                    <Setter TargetName="AttentionBadge" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="SubtitleText" Property="Foreground" Value="{StaticResource AttentionBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="{x:Static viewModels:TerminalStatus.Working}">
                                    <Setter TargetName="Spinner" Property="Visibility" Value="Visible" />
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard x:Name="SpinnerRotation">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Spinner" Storyboard.TargetProperty="RenderTransform.Angle"
                                                                 From="0" To="360" Duration="0:0:1" RepeatBehavior="Forever" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                    <DataTrigger.ExitActions>
                                        <StopStoryboard BeginStoryboardName="SpinnerRotation" />
                                    </DataTrigger.ExitActions>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="{x:Static viewModels:TerminalStatus.Exited}">
                                    <Setter TargetName="TitleText" Property="FontStyle" Value="Italic" />
                                    <Setter TargetName="TitleText" Property="Foreground" Value="{StaticResource MutedForegroundBrush}" />
                                </DataTrigger>
                                <!-- On hover the close button takes the place of the state indicator. -->
                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                    <Setter TargetName="CloseButton" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="AttentionBadge" Property="Visibility" Value="Collapsed" />
                                    <Setter TargetName="Spinner" Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Every terminal stays alive here; only the selected tab is shown. -->
        <Grid x:Name="TerminalArea" Background="{StaticResource TerminalBackgroundBrush}">
            <TextBlock Text="Aucun onglet ouvert. Choisissez un shell en bas du panneau." Foreground="{StaticResource MutedForegroundBrush}"
                       FontFamily="{StaticResource MonoFont}" Margin="12,10"
                       Visibility="{Binding Tabs.Count, Converter={x:Static shelldeck:Converters.ZeroToVisible}}" />
            <ItemsControl ItemsSource="{Binding Terminals}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Grid />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type viewModels:TerminalTab}">
                        <Grid>
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <!-- Hidden, not Collapsed: the terminals keep their size, so xterm.js does not reflow on tab switch. -->
                                    <Setter Property="Visibility" Value="Hidden" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>

                            <ItemsControl ItemsSource="{Binding Panes}" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <shelldeck:FractionalPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="shelldeck:FractionalPanel.Bounds" Value="{Binding Bounds}" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type viewModels:TerminalPane}">
                                        <!-- The border sits around the terminal, not over it: WPF cannot draw over WebView2 (airspace). -->
                                        <Border Margin="2" BorderThickness="1">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="BorderBrush" Value="Transparent" />
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsActive}" Value="True" />
                                                                <Condition Binding="{Binding DataContext.IsSplit, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="True" />
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <terminal:TerminalView />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <ItemsControl ItemsSource="{Binding Splits}" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <shelldeck:FractionalPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="shelldeck:FractionalPanel.Bounds" Value="{Binding Bounds}" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type viewModels:PaneSplit}">
                                        <Thumb Style="{StaticResource PaneSplitterStyle}" DragDelta="OnSplitterDragged" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- A Popup, because WPF content cannot be drawn over the WebView2 window (airspace). -->
            <Popup x:Name="AttentionToast" DataContext="{x:Null}" PlacementTarget="{Binding ElementName=TerminalArea}" Placement="Custom"
                   AllowsTransparency="True" StaysOpen="True">
                <Border Width="320" Margin="0,0,12,12" Padding="12" Cursor="Hand" MouseLeftButtonUp="OnToastClicked"
                        Background="{StaticResource ChromeRaisedBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.5" />
                    </Border.Effect>
                    <DockPanel>
                        <Rectangle DockPanel.Dock="Left" Width="3" Margin="-12,-12,10,-12" Fill="{StaticResource AttentionBrush}" />
                        <ContentControl DockPanel.Dock="Left" Content="{Binding Profile}" ContentTemplate="{StaticResource ShellTileTemplate}"
                                        Width="28" Height="28" FontSize="11" Margin="0,0,10,0" VerticalAlignment="Top" Focusable="False" />
                        <StackPanel>
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Notification}" Foreground="{StaticResource MutedForegroundBrush}" FontSize="12" TextWrapping="Wrap" />
                        </StackPanel>
                    </DockPanel>
                </Border>
            </Popup>
        </Grid>
    </DockPanel>
</Window>
