<Window x:Class="Pupitre.ProfileDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="480" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource ChromeBrush}" Foreground="{StaticResource ForegroundBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13">
    <StackPanel Margin="20,16,20,18">
        <TextBlock x:Name="DiscoveredHint" Foreground="{StaticResource MutedForegroundBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12"
                   Text="Terminal trouvé sur cette machine : seul son répertoire de démarrage se modifie." />

        <TextBlock Text="NOM" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,4" />
        <TextBox x:Name="NameBox" Style="{StaticResource FilterBoxStyle}" Tag="ex. Build" TextChanged="OnTextChanged" />

        <TextBlock Text="LIGNE DE COMMANDE" Style="{StaticResource SectionHeaderStyle}" Margin="0,14,0,4" />
        <TextBox x:Name="CommandLineBox" Style="{StaticResource FilterBoxStyle}" FontFamily="{StaticResource MonoFont}" FontSize="12"
                 Tag="ex. pwsh.exe -NoLogo" TextChanged="OnTextChanged" />

        <TextBlock Text="RÉPERTOIRE DE DÉMARRAGE" Style="{StaticResource SectionHeaderStyle}" Margin="0,14,0,4" />
        <DockPanel>
            <Button x:Name="BrowseButton" DockPanel.Dock="Right" Style="{StaticResource DialogButtonStyle}" MinWidth="0" Margin="6,0,0,0"
                    Content="Parcourir…" Click="OnBrowseClicked" />
            <TextBox x:Name="DirectoryBox" Style="{StaticResource FilterBoxStyle}" FontFamily="{StaticResource MonoFont}" FontSize="12" />
        </DockPanel>
        <TextBlock x:Name="DirectoryHint" Foreground="{StaticResource MutedForegroundBrush}" FontSize="11" TextWrapping="Wrap" Margin="2,4,0,0" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Style="{StaticResource DialogButtonStyle}" Content="Annuler" IsCancel="True" />
            <Button x:Name="SaveButton" Style="{StaticResource PrimaryButtonStyle}" Content="Enregistrer" IsDefault="True" Margin="8,0,0,0"
                    Click="OnSaveClicked" />
        </StackPanel>
    </StackPanel>
</Window>
